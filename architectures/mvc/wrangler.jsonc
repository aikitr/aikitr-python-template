{
  "name": "aikitr-mvc-api",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "python_workers",
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aikitr-mvc-tasks",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
