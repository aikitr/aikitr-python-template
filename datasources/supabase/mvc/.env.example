# Supabase Dashboard -> Connect -> Session pooler，替换整个连接串。
# 密码中的保留字符需要 URL 编码；只修改协议为 postgresql+psycopg。
APP_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require

# 可选：迁移使用 Direct connection（通常要求 IPv6 或 IPv4 add-on）。
# 不填写时，迁移使用 APP_DATABASE_URL。IPv4 环境可使用同一 Session pooler。
# APP_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
